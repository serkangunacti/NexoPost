generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum PlanId {
  free
  basic
  pro
  agency
  agency_plus
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionPhase {
  free
  trial
  paid
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum PublicationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIAL
  CANCELLED
  BLOCKED_QUOTA
  BLOCKED_X_BUDGET
  BLOCKED_PLAN_ACCESS
  BLOCKED_DAILY_CAP
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  hashedPassword         String            @map("hashed_password")
  fullName               String            @default("") @map("full_name")
  companyName            String            @default("") @map("company_name")
  phone                  String            @default("")
  activeWorkspaceId      String?           @map("active_workspace_id")
  superadminNote         String?           @map("superadmin_note") @db.Text
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  activeWorkspace        Workspace?        @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  subscription           Subscription?
  payments               Payment[]
  auditLogs              AuditLog[]
  postsAuthored          Post[]            @relation("PostAuthor")
  supportRequests        SupportRequest[]
  supportRepliesAuthored SupportReply[]
  workspaceMemberships   WorkspaceMember[]
  workspacesOwned        Workspace[]       @relation("WorkspaceOwner")

  @@map("users")
}

// One subscription per account owner; its plan applies to every workspace the user owns.
model Subscription {
  id                  String            @id @default(cuid())
  userId              String            @unique @map("user_id")
  plan                PlanId            @default(free)
  billingCycle        BillingCycle      @default(monthly) @map("billing_cycle")
  phase               SubscriptionPhase @default(free)
  hasUsedTrial        Boolean           @default(false) @map("has_used_trial")
  startedAt           DateTime          @default(now()) @map("started_at")
  currentPeriodStart  DateTime?         @map("current_period_start")
  currentPeriodEnd    DateTime?         @map("current_period_end")
  pendingPlan         PlanId?           @map("pending_plan")
  pendingBillingCycle BillingCycle?     @map("pending_billing_cycle")
  pendingEffectiveAt  DateTime?         @map("pending_effective_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  provider        String
  providerRef     String?       @map("provider_ref")
  plan            PlanId
  billingCycle    BillingCycle  @map("billing_cycle")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("USD")
  discountCodeId  String?       @map("discount_code_id")
  discountPercent Int?          @map("discount_percent")
  status          PaymentStatus
  failureReason   String?       @map("failure_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("payments")
}

model Workspace {
  id                 String                 @id @default(cuid())
  name               String
  status             WorkspaceStatus        @default(ACTIVE)
  ownerId            String                 @map("owner_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  owner              User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeForUsers     User[]                 @relation("ActiveWorkspace")
  auditLogs          AuditLog[]
  members            WorkspaceMember[]
  posts              Post[]
  publicationJobs    PublicationJob[]
  publicationResults PublicationResult[]
  socialAccounts     SocialAccount[]
  supportRequests    SupportRequest[]
  usagePeriods       WorkspaceUsagePeriod[]
  dailyUsage         WorkspaceDailyUsage[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// accessToken, refreshToken and pageAccessToken hold ciphertext from lib/secrets.
// Page tokens inside metadata.availablePages are encrypted the same way.
model SocialAccount {
  id                String              @id @default(cuid())
  workspaceId       String              @map("workspace_id")
  platform          String
  externalAccountId String              @map("external_account_id")
  displayName       String              @map("display_name")
  avatarUrl         String?             @map("avatar_url") @db.Text
  accessToken       String?             @map("access_token") @db.Text
  refreshToken      String?             @map("refresh_token") @db.Text
  tokenExpiresAt    DateTime?           @map("token_expires_at")
  scopes            Json?
  pageId            String?             @map("page_id")
  pageName          String?             @map("page_name")
  pageAccessToken   String?             @map("page_access_token") @db.Text
  status            SocialAccountStatus @default(CONNECTED)
  metadata          Json?
  connectedAt       DateTime            @default(now()) @map("connected_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  publicationJobs   PublicationJob[]
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
  @@map("social_accounts")
}

model Post {
  id                 String              @id @default(uuid())
  content            String              @db.Text
  platforms          Json
  platformConfig     Json?               @map("platform_config")
  status             String              @default("Draft")
  date               String
  time               String
  scheduledAt        DateTime?           @map("scheduled_at")
  autoOptimize       Boolean             @default(false) @map("auto_optimize")
  mediaUrls          Json                @map("media_urls")
  userId             String              @map("user_id")
  workspaceId        String?             @map("workspace_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  author             User                @relation("PostAuthor", fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  mediaAssets        MediaAsset[]
  publicationJobs    PublicationJob[]
  publicationResults PublicationResult[]
  variants           PostVariant[]

  @@index([workspaceId, createdAt])
  @@map("posts")
}

model MediaAsset {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  kind         String
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  width        Int?
  height       Int?
  durationMs   Int?     @map("duration_ms")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("media_assets")
}

model PostVariant {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  platform  String
  content   String   @db.Text
  mediaUrls Json?    @map("media_urls")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@map("post_variants")
}

model PublicationJob {
  id                 String               @id @default(cuid())
  postId             String               @map("post_id")
  workspaceId        String               @map("workspace_id")
  socialAccountId    String?              @map("social_account_id")
  platform           String
  status             PublicationJobStatus @default(PENDING)
  attempts           Int                  @default(0)
  maxAttempts        Int                  @default(5) @map("max_attempts")
  scheduledFor       DateTime?            @map("scheduled_for")
  startedAt          DateTime?            @map("started_at")
  finishedAt         DateTime?            @map("finished_at")
  lastError          String?              @map("last_error") @db.Text
  quotaChargedAt     DateTime?            @map("quota_charged_at")
  quotaChargeUnits   Int                  @default(0) @map("quota_charge_units")
  xSpendChargedCents Int                  @default(0) @map("x_spend_charged_cents")
  payload            Json?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  post               Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  result             PublicationResult?
  socialAccount      SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([workspaceId, createdAt])
  @@map("publication_jobs")
}

model PublicationResult {
  id           String               @id @default(cuid())
  jobId        String               @unique @map("job_id")
  postId       String               @map("post_id")
  workspaceId  String               @map("workspace_id")
  platform     String
  status       PublicationJobStatus
  remoteId     String?              @map("remote_id")
  remoteUrl    String?              @map("remote_url")
  payload      Json?
  errorMessage String?              @map("error_message") @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  job          PublicationJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  post         Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("publication_results")
}

model WorkspaceUsagePeriod {
  id                       String       @id @default(cuid())
  workspaceId              String       @map("workspace_id")
  plan                     PlanId
  billingCycle             BillingCycle @map("billing_cycle")
  periodStart              DateTime     @map("period_start")
  periodEnd                DateTime     @map("period_end")
  platformJobsIncluded     Int?         @map("platform_jobs_included")
  platformJobsUsed         Int          @default(0) @map("platform_jobs_used")
  platformJobsBlocked      Int          @default(0) @map("platform_jobs_blocked")
  xSpendCapCents           Int?         @map("x_spend_cap_cents")
  xSpendUsedCents          Int          @default(0) @map("x_spend_used_cents")
  xSpendBlockedCents       Int          @default(0) @map("x_spend_blocked_cents")
  perPlatformMonthlyCounts Json?        @map("per_platform_monthly_counts")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  workspace                Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd])
  @@map("workspace_usage_periods")
}

model WorkspaceDailyUsage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  date        DateTime  @db.Date
  platform    String
  usedJobs    Int       @default(0) @map("used_jobs")
  blockedJobs Int       @default(0) @map("blocked_jobs")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, platform])
  @@map("workspace_daily_usage")
}

model DiscountCode {
  id                   String               @id @default(cuid())
  code                 String               @unique
  percentOff           Int                  @map("percent_off")
  startsAt             DateTime?            @map("starts_at")
  expiresAt            DateTime?            @map("expires_at")
  maxRedemptions       Int?                 @map("max_redemptions")
  redeemedCount        Int                  @default(0) @map("redeemed_count")
  allowedPlans         Json?                @map("allowed_plans")
  allowedBillingCycles Json?                @map("allowed_billing_cycles")
  isActive             Boolean              @default(true) @map("is_active")
  metadata             Json?
  createdById          String?              @map("created_by_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  redemptions          DiscountRedemption[]
  payments             Payment[]

  @@index([isActive, expiresAt])
  @@map("discount_codes")
}

model DiscountRedemption {
  id             String       @id @default(cuid())
  discountCodeId String       @map("discount_code_id")
  userId         String?      @map("user_id")
  email          String?
  plan           PlanId
  billingCycle   BillingCycle @map("billing_cycle")
  percentOff     Int          @map("percent_off")
  redeemedAt     DateTime     @default(now()) @map("redeemed_at")
  orderContext   Json?        @map("order_context")
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@index([discountCodeId, redeemedAt])
  @@index([userId, redeemedAt])
  @@map("discount_redemptions")
}

model XRateCard {
  id                 String   @id @default(cuid())
  code               String   @unique
  version            String
  estimatedCostCents Int      @map("estimated_cost_cents")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([active, code])
  @@map("x_rate_cards")
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?    @map("user_id")
  workspaceId String?    @map("workspace_id")
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  payload     Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SupportRequest {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  workspaceId     String?        @map("workspace_id")
  subject         String
  message         String         @db.Text
  attachmentUrls  Json?          @map("attachment_urls")
  status          String         @default("OPEN")
  lastUserReadAt  DateTime?      @map("last_user_read_at")
  lastStaffReadAt DateTime?      @map("last_staff_read_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  replies         SupportReply[]

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("support_requests")
}

model SupportReply {
  id                String         @id @default(cuid())
  supportRequestId  String         @map("support_request_id")
  authorUserId      String?        @map("author_user_id")
  authorType        String         @map("author_type")
  source            String         @default("PORTAL")
  body              String         @db.Text
  attachmentUrls    Json?          @map("attachment_urls")
  externalMessageId String?        @unique @map("external_message_id")
  seenByUserAt      DateTime?      @map("seen_by_user_at")
  seenByStaffAt     DateTime?      @map("seen_by_staff_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  authorUser        User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  supportRequest    SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@index([supportRequestId, createdAt])
  @@index([authorType, createdAt])
  @@index([seenByUserAt, createdAt])
  @@map("support_replies")
}

// OAuth state and session stores for the Bluesky client. `value` is ciphertext from lib/secrets.
model OAuthStateStore {
  key       String   @id
  provider  String
  value     String   @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provider, expiresAt])
  @@map("oauth_state_store")
}

model OAuthSessionStore {
  key       String   @id
  provider  String
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provider])
  @@map("oauth_session_store")
}
